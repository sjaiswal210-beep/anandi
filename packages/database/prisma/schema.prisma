// ============================================
// HR, ATTENDANCE & PAYROLL MODELS
// ============================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  LEAVE
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  LOP // Loss of Pay / Unpaid
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum SalaryType {
  MONTHLY
  DAILY_WAGE
  HOURLY
}

model Employee {
  id                String          @id @default(uuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            String?         @unique // Link to User login if they are a CRM user
  user              User?           @relation(fields: [userId], references: [id])
  
  name              String
  email             String?
  phone             String          @unique
  department        String          // e.g. "Sales", "Construction", "Finance", "Admin"
  designation       String          // e.g. "Executive", "Manager", "Site Engineer"
  status            EmployeeStatus  @default(ACTIVE)
  deviceInfo        String?         // Details of the mobile device logged into the worker portal
  
  // Payroll / Salary settings
  salaryType        SalaryType      @default(MONTHLY)
  baseSalary        Decimal         @default(0.00) @db.Decimal(12, 2)
  dailyRate         Decimal?        @db.Decimal(12, 2)
  hourlyRate        Decimal?        @db.Decimal(12, 2)
  currency          String          @default("INR")
  
  // Bank Account & Tax details (for payouts)
  panNumber         String?
  bankName          String?
  bankAccountNumber String?
  bankIfscCode      String?
  
  joiningDate       DateTime
  exitDate          DateTime?
  
  // Relations
  attendances       Attendance[]
  leaves            Leave[]
  payrolls          Payroll[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
  @@map("employees")
}

model Attendance {
  id               String           @id @default(uuid())
  workspaceId      String
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  date             DateTime         // Calendar date (YYYY-MM-DD at 00:00:00)
  checkIn          DateTime?        // Actual punch-in timestamp
  checkOut         DateTime?        // Actual punch-out timestamp
  status           AttendanceStatus @default(PRESENT)
  
  // Geo-Fencing & Verification
  checkInLocation  String?          // GPS Coordinates as "lat,lng"
  checkOutLocation String?          // GPS Coordinates as "lat,lng"
  checkInIp        String?
  checkOutIp       String?
  photoIn          String?          // Base64 compressed image captured during check-in
  photoOut         String?          // Base64 compressed image captured during check-out
  
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([workspaceId])
  @@map("attendances")
}

model Leave {
  id               String      @id @default(uuid())
  workspaceId      String
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  type             LeaveType   @default(CASUAL)
  startDate        DateTime
  endDate          DateTime
  days             Int
  reason           String
  status           LeaveStatus @default(PENDING)
  
  approvedById     String?
  approvedBy       User?       @relation(fields: [approvedById], references: [id])
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([workspaceId])
  @@map("leaves")
}

model Payroll {
  id               String        @id @default(uuid())
  workspaceId      String
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  month            Int           // 1 to 12
  year             Int           // e.g. 2026
  
  // Calculations Summary
  totalDays        Int           // Days in month
  presentDays      Int
  halfDays         Int
  absentDays       Int
  paidLeaves       Int
  unpaidLeaves     Int           // Loss Of Pay days
  
  // Financial breakdown
  baseSalary       Decimal       @db.Decimal(12, 2)
  allowances       Decimal       @default(0.00) @db.Decimal(12, 2)
  deductions       Decimal       @default(0.00) @db.Decimal(12, 2) // LOP subtractions
  netSalary        Decimal       @db.Decimal(12, 2) // final calculated payout
  
  status           PayrollStatus @default(DRAFT)
  paymentDate      DateTime?
  paymentReference String?       // transaction/ref ID
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([employeeId, month, year])
  @@index([workspaceId])
  @@map("payrolls")
}

model AttendanceToken {
  id          String   @id @default(uuid())
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("attendance_tokens")
}

