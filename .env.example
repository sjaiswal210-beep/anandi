# ===========================================
# RealtyOS AI - Environment Variables
# ===========================================

# Application
NODE_ENV=development
APP_NAME=RealtyOS AI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://realtyos:realtyos_secret@localhost:5432/realtyos_db
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication (Auth.js)
AUTH_SECRET=your-auth-secret-here-change-in-production
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Storage (S3 / R2)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=realtyos-uploads
# For Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=realtyos-uploads
R2_ENDPOINT=

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@realtyos.ai

# SMS
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FCM_SERVER_KEY=

# Payment / Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps
GOOGLE_MAPS_API_KEY=

# Voice AI
VOICE_AI_PROVIDER=openai
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Monitoring
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Feature Flags
FEATURE_FLAGS_PROVIDER=local

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Meta Lead Ads + comment capture (polled, no public webhook needed)
# Page token needs: leads_retrieval, pages_read_engagement,
# pages_manage_engagement, and instagram_manage_comments for Instagram.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_VERIFY_TOKEN=anandi-park-meta-verify

# Vobiz Telephony (TTS Calls)
# Sign up at console.vobiz.ai — credentials are on the dashboard.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=+91XXXXXXXXXX
# The public URL Vobiz calls back to when a call connects.
# Must be reachable from the internet.
VOBIZ_CALLBACK_URL=http://147.93.169.183:4000

# Sarvam TTS (human voice generation for calls)
# Free ₹1000 credit at dashboard.sarvam.ai
SARVAM_API_KEY=
