# ===========================================
# Anandi Park — Environment Variables
# Copy to .env and fill in real values. .env is gitignored.
# On the VPS a single /opt/anandi-park/anandi/.env holds all of these.
# ===========================================

# ---- Core ----
NODE_ENV=production
APP_NAME=Anandi Park
# Public site origin (used for CORS allowlist)
APP_URL=https://anandipark.in
API_URL=https://api.anandipark.in
# Optional extra CORS origins, comma-separated
CORS_ORIGINS=

# ---- Database (Neon cloud PostgreSQL — no local Postgres needed) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
AUTH_SECRET=change-me

# ---- AI (Google Gemini) ----
# Google AI Studio key with billing enabled (needed for image generation).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional override for the image model (default handled in code).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AI_PROVIDER=gemini
# Optional fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# ---- Meta: Facebook + Instagram publish, Ads, Lead Ads ----
# Use a NON-EXPIRING System User token (Business Settings > Users > System Users
# > Generate Token > expiration: Never). The code exchanges it for a Page token
# at runtime, so a system-user token is correct here.
# Scopes needed: pages_manage_posts, pages_read_engagement, pages_show_list,
#   instagram_basic, instagram_content_publish, ads_read, ads_management,
#   pages_manage_ads, leads_retrieval (+ instagram_manage_comments optional).
META_PAGE_ID=1190123837525578
META_IG_USER_ID=17841436055562071
META_AD_ACCOUNT_ID=act_1393094840853010
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=anandi-park-meta-verify
# Base URL Meta uses to fetch uploaded images for IG publishing.
API_PUBLIC_URL=https://api.anandipark.in

# ---- WhatsApp bridge (separate service on the VPS, port 8300) ----
VPS_WHATSAPP_URL=http://127.0.0.1:8300
VPS_WHATSAPP_SECRET=
VPS_WHATSAPP_BIZ_ID=anandi-park
WHATSAPP_VERIFY_TOKEN=anandi-park-verify

# ---- Telephony (Vobiz) ----
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=+91XXXXXXXXXX
# Must be public HTTPS; Vobiz GETs this when a call connects.
VOBIZ_CALLBACK_URL=https://api.anandipark.in

# ---- TTS (Sarvam — human voice for calls + video voiceovers) ----
SARVAM_API_KEY=

# ---- IMPORTANT ----
# Do NOT set NEXT_PUBLIC_API_URL to an http://IP value for the web build.
# It gets inlined at build time and causes mixed-content blocking on the HTTPS
# domain (dashboard shows zeros). Leave it unset — the web app resolves the API
# URL from the hostname at runtime. Only set it to a full HTTPS URL if pinning.
# NEXT_PUBLIC_API_URL=https://api.anandipark.in/api/v1
